{
	admin off
	auto_https {$AUTO_HTTPS:off}
}

# Three modes from one image (08-deployment.md §4):
#   · behind the university proxy (current):  defaults → listens :8080, plain HTTP
#   · public domain, auto-TLS:                SITE_ADDRESS=club.example.edu AUTO_HTTPS=on
#   · local preview:                          SITE_ADDRESS=:8080
# Switching is an env change and a restart — no rebuild, provided SITE_URL at BUILD time already
# matched the final public URL.
{$SITE_ADDRESS::8080} {
	root * /srv

	# `build.format: 'directory'` writes /club/index.html, and `trailingSlash: 'never'` means every
	# canonical, sitemap entry and internal link points at /club with NO slash. Left to itself,
	# file_server sees a directory and answers 308 → /club/ — so every single navigation would cost
	# a redirect to a URL the page's own <link rel="canonical"> disagrees with.
	#
	# try_files resolves the index file before file_server ever sees a directory. Order matters:
	# {path}/index.html must come before {path}, or the directory match wins and the redirect is back.
	try_files {path}.html {path}/index.html {path}
	file_server
	encode zstd gzip

	# Content-hashed build assets — safe to cache forever, because the hash changes when they do.
	# Astro emits the font files under /_astro/fonts/, so that one path covers them too.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Full-resolution originals — long cache, they never change under a given name.
	@originals path /originals/*
	header @originals Cache-Control "public, max-age=604800"

	# Everything else — pages, the Pagefind index, the generated OG cards, robots and the sitemap —
	# revalidates, so a redeploy is visible immediately. `build.format: 'directory'` means pages are
	# served from `<dir>/index.html` with no extension in the URL, which is why this cannot match on
	# `*.html`.
	#
	# It cannot match on the response Content-Type either, which is what an earlier version tried:
	# `@html header Content-Type text/html*` is a REQUEST header matcher, and a GET request carries
	# no Content-Type — so it silently never matched and every page shipped with no Cache-Control at
	# all. Path negation is what actually works here.
	@revalidate not path /_astro/* /originals/*
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		-Server
	}

	# The Content-Security-Policy (08-deployment.md §6, D29). GENERATED at build by
	# src/integrations/generate-csp.ts from the inline scripts and video providers the built output
	# actually contains, so it can never drift from the HTML and `frame-src` is never hand-widened.
	#
	# It lives outside /srv deliberately: it is server configuration, not a static asset.
	# The header ships as Content-Security-Policy-Report-Only until CSP_HEADER is set — see the
	# comments inside the generated file.
	import /etc/caddy/csp.caddy

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

