# Copy to .env before deploying. `.env` is git-ignored.

# The canonical origin, ORIGIN ONLY — no path suffix. `https://…/club` here would produce
# /club/club/projects everywhere.
#
# 🔴 D30 IS UNRESOLVED. Two domains were supplied:
#     https://www.innochipdesign.ru                      ← recommended canonical
#     https://innochipdesign.campus.innopolis.university  ← recommended 301 alias
#
# Pick ONE before the first production build. Serving the same image on both hostnames means every
# page declares a canonical pointing at the other host for half its visitors, and splits any search
# ranking between them. If the campus host must serve content directly, build the image TWICE with
# different SITE_URL values and run two containers — do not serve one build under two names.
SITE_URL=https://www.innochipdesign.ru

# Caddy's listen address inside the container.
#   :8080                  behind the university reverse proxy (current topology)
#   club.example.edu       public domain — set AUTO_HTTPS=on to obtain Let's Encrypt certs
SITE_ADDRESS=:8080
AUTO_HTTPS=off

# Host port published by docker compose.
HOST_PORT=8080

# The Content-Security-Policy header NAME (D29). The policy itself is generated at build time and
# never edited by hand — see DEPLOY.md.
#
# Leave this unset to ship report-only, which is what a first deploy wants: the browser reports
# violations instead of blocking them. After a week of clean reports, uncomment the line below and
# restart. No rebuild — the name is read at runtime.
#
# CSP_HEADER=Content-Security-Policy
