---
interface Props {
  title: string;
  class?: string;
}
const { title, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'rounded-(--radius-lg) border border-dashed border-(--color-border) px-6 py-12 text-center',
    className,
  ]}
>
  <p class="font-(family-name:--font-display) text-(length:--text-h3)">{title}</p>
  <div class="mt-2 text-(length:--text-meta) text-(--color-muted)"><slot /></div>
</div>
