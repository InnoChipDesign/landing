---
/**
 * An off-site link with `rel="noopener noreferrer"` and the ↗ glyph, in one place rather than at
 * every call site. The glyph is `aria-hidden`; the announcement comes from the appended
 * "(opens in a new tab)" so a screen-reader user learns the same thing a sighted one does.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  class?: string;
  /** Set false when the surrounding text already says the link leaves the site. */
  announce?: boolean;
}

const { href, class: className = '', announce = true } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'inline-flex items-center gap-1 text-(--color-accent) underline decoration-(--color-border) transition-colors duration-(--dur-fast) hover:decoration-current',
    className,
  ]}
>
  <slot />
  <Icon name="lucide:arrow-up-right" class="size-3.5 shrink-0" aria-hidden="true" />
  {announce && <span class="sr-only">(opens in a new tab)</span>}
</a>
