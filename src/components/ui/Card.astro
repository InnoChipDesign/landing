---
/** Surface with a border. `href` makes the whole card one link (06 §5 — no scale, no rotation). */
interface Props {
  href?: string;
  external?: boolean;
  class?: string;
  'aria-label'?: string;
}

const { href, external, class: className = '', ...rest } = Astro.props;
const isExternal = external ?? (!!href && /^https?:\/\//.test(href));
const Tag = href ? 'a' : 'div';

const classes = [
  'block rounded-(--radius-lg) border border-(--color-border) bg-(--color-bg) p-6 shadow-(--shadow-sm)',
  href &&
    'transition-[transform,box-shadow,border-color] duration-(--dur-base) ease-(--ease-out) hover:-translate-y-0.5 hover:border-(--color-accent)/40 hover:shadow-(--shadow-md)',
  className,
];
---

<Tag
  href={href}
  class:list={classes}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  {...rest}
>
  <slot />
</Tag>
