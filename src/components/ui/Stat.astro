---
/**
 * One figure in the stats band. Every value passed in must be DERIVED from content at build time
 * (05 §4) — a hardcoded number goes stale, and every visitor who notices one stops trusting the
 * rest of the page.
 *
 * Deliberately never used for a member count: the roster is partial by design (D8), so a count
 * from people.yaml would understate the club and a typed one would be a fiction.
 */
interface Props {
  value: string | number;
  label: string;
}
const { value, label } = Astro.props;
---

<div>
  <div class="font-(family-name:--font-display) text-3xl font-semibold">{value}</div>
  <div class="mt-1 text-(length:--text-meta) text-(--color-muted)">{label}</div>
</div>
