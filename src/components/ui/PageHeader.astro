---
/** One <h1> per page, one line of context under it (06 §6.3). */
import Container from '../layout/Container.astro';

interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<Container class="pt-12 pb-8 sm:pt-16">
  <h1 class="text-(length:--text-display) leading-(--text-display--line-height)">{title}</h1>
  {
    lead && (
      <p class="mt-4 max-w-(--spacing-prose) text-(length:--text-lead) text-(--color-muted)">
        {lead}
      </p>
    )
  }
  <slot />
</Container>
