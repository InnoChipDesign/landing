---
/** Vertical rhythm: 96px desktop, 64px mobile (06 §3). */
import Container from '../layout/Container.astro';

interface Props {
  id?: string;
  title?: string;
  lead?: string;
  /** Right-aligned link beside the heading — "20 projects and counting →". */
  actionLabel?: string;
  actionHref?: string;
  tone?: 'default' | 'surface';
  class?: string;
}

const { id, title, lead, actionLabel, actionHref, tone = 'default', class: className = '' } =
  Astro.props;
---

<section
  id={id}
  class:list={[
    'py-16 sm:py-24',
    tone === 'surface' && 'bg-(--color-surface)',
    className,
  ]}
>
  <Container>
    {
      (title || actionLabel) && (
        <div class="mb-8 flex flex-wrap items-baseline justify-between gap-4">
          <div class="max-w-(--spacing-prose)">
            {title && <h2 class="text-(length:--text-h2) leading-(--text-h2--line-height)">{title}</h2>}
            {lead && <p class="mt-3 text-(length:--text-lead) text-(--color-muted)">{lead}</p>}
          </div>
          {actionLabel && actionHref && (
            <a
              href={actionHref}
              class="text-(length:--text-meta) font-medium text-(--color-accent) hover:underline"
            >
              {actionLabel} →
            </a>
          )}
        </div>
      )
    }
    <slot />
  </Container>
</section>
