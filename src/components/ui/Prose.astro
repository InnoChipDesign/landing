---
/**
 * Long-form body copy. Column capped at 68ch (06 §2) — serif headings over a sans body, and never
 * serif body text, which is how an "academic" design becomes an unreadable one.
 *
 * Figures inside prose may break out to full column width via `.breakout`.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['prose-club', className]}>
  <slot />
</div>

<style is:global>
  .prose-club {
    max-width: var(--spacing-prose);
  }

  .prose-club > * + * {
    margin-top: 1.25em;
  }

  .prose-club h2 {
    margin-top: 2.5em;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
  }

  .prose-club h3 {
    margin-top: 2em;
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
  }

  .prose-club a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .prose-club a:hover {
    text-decoration-color: currentColor;
  }

  .prose-club ul,
  .prose-club ol {
    padding-left: 1.5em;
  }

  .prose-club ul {
    list-style: disc;
  }

  .prose-club ol {
    list-style: decimal;
  }

  .prose-club li + li {
    margin-top: 0.4em;
  }

  .prose-club blockquote {
    border-left: 3px solid var(--color-border);
    padding-left: 1em;
    color: var(--color-muted);
  }

  /* Shiki emits both themes; the dark one is swapped in by the .dark class rather than by a media
     query, so an explicit toggle wins over the OS setting. */
  .prose-club pre {
    overflow-x: auto;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose-club :not(pre) > code {
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }

  .dark .prose-club .astro-code,
  .dark .prose-club .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }

  .prose-club .breakout {
    max-width: none;
    width: 100%;
  }

  .prose-club figure figcaption {
    margin-top: 0.5em;
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
</style>
