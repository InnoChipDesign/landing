---
/**
 * A portal tile (D19). Deliberately separate from the club's `Card` so the portal's look can
 * diverge without dragging the club site with it.
 *
 * The whole card is one link. An optional screenshot renders as a muted background — never as the
 * card's only content, since a screenshot of a waveform viewer tells a first-time visitor nothing.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { name, tagline, url, kind, screenshot, screenshotAlt } = service.data;
const isExternal = kind === 'external';
---

<a
  href={url}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  aria-label={isExternal ? `${name} — opens in a new tab` : name}
  class="group relative isolate flex min-h-52 flex-col justify-between overflow-hidden rounded-(--radius-lg) border border-(--color-border) bg-(--color-bg) p-6 shadow-(--shadow-sm) transition-[transform,box-shadow,border-color] duration-(--dur-base) ease-(--ease-out) hover:-translate-y-0.5 hover:border-(--color-accent)/40 hover:shadow-(--shadow-md)"
>
  {
    screenshot && (
      <Image
        src={screenshot}
        alt={screenshotAlt ?? ''}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 380px, 100vw"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 -z-10 size-full object-cover opacity-[0.07]"
      />
    )
  }

  <Icon name="lucide:cpu" class="size-6 text-(--color-accent)" aria-hidden="true" />

  <div class="mt-6">
    <h2 class="flex items-center gap-2 text-(length:--text-h3) leading-(--text-h3--line-height)">
      {name}
      {isExternal && <Icon name="lucide:arrow-up-right" class="size-4 text-(--color-muted)" aria-hidden="true" />}
    </h2>
    {tagline && <p class="mt-2 text-(--color-muted)">{tagline}</p>}
  </div>
</a>
