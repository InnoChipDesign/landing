---
/**
 * Shared "under construction" stub view for portal services not yet deployed (/vcd, /homework).
 *
 * Uses PortalLayout (not PageLayout) because these are sibling properties of /club, not subpages
 * of the club site. All service metadata comes from src/data/services.ts and club links from
 * src/data/site.ts so nothing is duplicated or hardcoded.
 */
import PortalLayout from '~/layouts/PortalLayout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logo from '~/assets/logo.svg';
import { site } from '~/data/site';
import type { Service } from '~/data/services';

export interface Props {
  service: Service;
}

const { service } = Astro.props;

const metadata = {
  title: `${service.name} — Under Construction`,
  description: `${service.tagline} Currently under construction.`,
  robots: {
    index: false,
    follow: true,
  },
};
---

<PortalLayout metadata={metadata}>
  <section class="flex min-h-screen items-center px-4 py-16 sm:px-6">
    <div class="mx-auto w-full max-w-xl">
      <div class="mb-8 flex items-center justify-center">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 text-sm font-medium text-muted transition hover:text-(--club-text)"
        >
          <Image src={logo} alt="" width={24} height={24} class="size-6 rounded" aria-hidden="true" />
          <span>{site.name}</span>
        </a>
      </div>

      <div
        class="rounded-(--radius-lg) border border-(--club-border) bg-page p-8 text-center shadow-(--shadow-sm) sm:p-10"
      >
        <div class="mx-auto flex size-14 items-center justify-center rounded-(--radius-md) bg-primary/10 text-primary">
          <Icon name={service.icon} class="size-8" />
        </div>

        <div
          class="mt-6 inline-flex items-center gap-1.5 rounded-full border border-(--club-border) bg-surface px-3 py-1 text-xs font-medium tracking-wide text-muted uppercase"
        >
          <Icon name="tabler:tools" class="size-3.5 text-primary" />
          <span>Under construction</span>
        </div>

        <h1 class="mt-4 text-3xl font-bold sm:text-4xl">
          {service.name}
        </h1>

        <p class="mt-3 text-lg text-muted">
          {service.tagline}
        </p>

        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted">
          This service is currently being prepared and is not available yet. Follow progress in our{' '}
          <a
            href={site.contact.chat}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-primary underline underline-offset-4 hover:text-secondary"
          >
            Telegram chat</a
          >, or explore the student club in the meantime.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={site.clubBase} class="btn-primary">Go to the club site</a>
          <a href="/" class="btn">
            <Icon name="tabler:arrow-left" class="mr-2 size-4" />
            Come back
          </a>
        </div>
      </div>
    </div>
  </section>
</PortalLayout>
