---
/**
 * The design system, and the bridge onto AstroWind's variables.
 *
 * "Light, bright & academic": light default, generous whitespace, serif headings over a sans body.
 * Dark mode is a toggle, not a default.
 *
 * Two layers, and the split matters:
 *
 *   --club-*  the palette. The only place a raw hex may appear. If you need a colour that is not
 *             here, add a token — do not inline one.
 *   --aw-*    AstroWind's variables, aliased onto the tokens above. Every widget in the template
 *             reads these, so the whole theme follows from this file.
 *
 * The club tokens are NOT named --color-*: src/assets/styles/tailwind.css already declares
 * `--color-accent: var(--aw-color-accent)` in its @theme block. Naming ours the same would make
 * --color-accent and --aw-color-accent reference each other and resolve to nothing.
 *
 * Because the aliases are var() chains, `.dark` only redefines the --club-* tokens. That gives us
 * the rule for free: no colour is ever defined *only* inside .dark, so a missed token can never
 * render as transparent or black-on-black.
 */
---

<style is:inline>
  :root {
    /* ── colour: light (default) ─────────────────────────── */
    --club-bg: #ffffff;
    --club-surface: #f6f7f9;
    --club-surface-2: #edeff3;
    --club-border: #dfe3e8;
    --club-text: #10151c;
    --club-muted: #5b6672;
    --club-accent: #1d4ed8; /* primary action, links */
    --club-accent-hover: #1740b4;
    --club-accent-soft: #eaf0fe; /* chip / callout background */

    /* The club mark's green. It is a BRAND colour, not the interactive one, and the distinction is
       load-bearing: #40BA21 on white is 2.2:1, so it fails WCAG AA for text and for a focus ring by
       a wide margin. Darkening it far enough to pass (≈ #1B6410) is no longer the club's green. So
       the accent stays blue and this token is used only where the colour carries no information a
       screen reader would miss — the mark itself. Never a link, a button or a focus ring. */
    --club-brand: #40ba21;

    --club-warm: #f59e0b; /* awards, highlights — used sparingly */
    --club-success: #0f766e;
    --club-danger: #b4212c;

    /* ── AstroWind bridge ────────────────────────────────── */
    /* Each --font-*-face is generated by the Fonts API from the block in astro.config.ts and
       already contains the family name plus metric-matched fallbacks — Astro measures the real
       font and synthesises size-adjusted fallback faces, so the swap does not reflow the page. */
    --aw-font-sans: var(--font-sans-face);
    --aw-font-serif: var(--font-display-face);
    --aw-font-heading: var(--font-display-face);

    --aw-color-primary: var(--club-accent);
    --aw-color-secondary: var(--club-accent-hover);
    --aw-color-accent: var(--club-accent);

    --aw-color-text-heading: var(--club-text);
    --aw-color-text-default: var(--club-text);
    --aw-color-text-muted: var(--club-muted);
    /* Upstream references this in `@utility text-page` (which `btn` applies) but never defines it,
       so every stock AstroWind button's text colour falls through to `inherit`. */
    --aw-color-text-page: var(--club-text);
    --aw-color-bg-page: var(--club-bg);
    --aw-color-bg-page-dark: #0e1116;

    /* Surfaces and borders, exposed for the @theme keys in tailwind.css. */
    --aw-color-surface: var(--club-surface);
    --aw-color-surface-2: var(--club-surface-2);
    --aw-color-border: var(--club-border);

    ::selection {
      background-color: var(--club-accent-soft);
      color: var(--club-text);
    }
  }

  .dark {
    --club-bg: #0e1116;
    --club-surface: #161b22;
    --club-surface-2: #1e252e;
    --club-border: #2a323c;
    --club-text: #e9edf2;
    --club-muted: #97a2af;
    --club-accent: #6e9bff; /* lightened — #1d4ed8 fails contrast on dark */
    --club-accent-hover: #8fb2ff;
    --club-accent-soft: #16233d;

    /* --club-brand does not change: the mark is a reversed green field and carries its own ground. */

    --club-warm: #fbbf24;
    --club-success: #34d399;
    --club-danger: #f87171;

    /* No --aw-* alias is restated here — every one of them resolves through the tokens above. */

    ::selection {
      background-color: var(--club-accent-soft);
      color: var(--club-text);
    }
  }
</style>
