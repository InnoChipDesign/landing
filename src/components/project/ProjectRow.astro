---
/**
 * The directory's unit (D20). It appears ~20 times on the busiest page, so it is the component the
 * site is judged on.
 *
 * Rules from 06 §4, all load-bearing:
 *   · the whole row is ONE <a> — chips inside are <span>, never links
 *   · the focus ring wraps the entire row, not the title
 *   · hover raises the background one surface step; NO translate. Rows shifting under the cursor
 *     in a long list is nauseating.
 */
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import ProjectCover from './ProjectCover.astro';
import Chip from '../ui/Chip.astro';
import StatusPill from '../ui/StatusPill.astro';
import { routes } from '../../lib/routes';
import { formatTerm } from '../../lib/format';

interface Props {
  project: CollectionEntry<'projects'>;
  tagLabels: Map<string, { label: string; color: string }>;
}

const { project, tagLabels } = Astro.props;
const { data } = project;
---

<li
  class="content-auto border-b border-(--color-border) last:border-b-0"
  data-project
  data-tags={data.tags.join(' ')}
  data-year={data.year}
  data-semester={data.semester ?? ''}
  data-status={data.status}
>
  <a
    href={routes.project(project.id)}
    class="flex flex-col gap-4 rounded-(--radius-md) p-4 transition-colors duration-(--dur-fast) ease-(--ease-out) hover:bg-(--color-surface) sm:flex-row sm:items-start sm:gap-6"
  >
    <ProjectCover
      slug={project.id}
      title={data.title}
      image={data.cover}
      alt={data.coverAlt}
      class="w-full shrink-0 sm:w-32 lg:w-45"
    />

    <div class="min-w-0 flex-1">
      <h3 class="text-(length:--text-h3) leading-(--text-h3--line-height)">{data.title}</h3>
      <p class="mt-1 line-clamp-2 text-(--color-muted)">{data.summary}</p>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        {
          data.tags.map((tag) => (
            <Chip label={tagLabels.get(tag)?.label ?? tag} color={tagLabels.get(tag)?.color} />
          ))
        }
      </div>
    </div>

    <div
      class="flex shrink-0 flex-wrap items-center gap-3 text-(length:--text-meta) text-(--color-muted) sm:flex-col sm:items-end sm:gap-2"
    >
      <span>{formatTerm(data.year, data.semester)}</span>
      <StatusPill status={data.status} />
      {
        /* One-glance signal that a demo exists, with no media loaded (03 §1). */
        data.video && (
          <span class="inline-flex items-center gap-1">
            <Icon name="lucide:play" class="size-3.5" aria-hidden="true" />
            <span class="sr-only">Has a demo video</span>
          </span>
        )
      }
    </div>
  </a>
</li>
