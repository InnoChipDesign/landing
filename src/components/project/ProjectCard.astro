---
/**
 * The homepage featured strip only (05 §4) — three cards, a teaser. The directory uses ProjectRow
 * (D20); a grid there would amplify the inconsistency of ~20 heterogeneous cover images, which is
 * exactly what a row list absorbs.
 */
import type { CollectionEntry } from 'astro:content';
import ProjectCover from './ProjectCover.astro';
import Chip from '../ui/Chip.astro';
import { routes } from '../../lib/routes';

interface Props {
  project: CollectionEntry<'projects'>;
  tagLabels: Map<string, { label: string; color: string }>;
}

const { project, tagLabels } = Astro.props;
const { data } = project;
---

<a
  href={routes.project(project.id)}
  class="group flex flex-col overflow-hidden rounded-(--radius-lg) border border-(--color-border) bg-(--color-bg) shadow-(--shadow-sm) transition-[transform,box-shadow,border-color] duration-(--dur-base) ease-(--ease-out) hover:-translate-y-0.5 hover:border-(--color-accent)/40 hover:shadow-(--shadow-md)"
>
  <ProjectCover
    slug={project.id}
    title={data.title}
    image={data.cover}
    alt={data.coverAlt}
    aspect="16/9"
    sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
    widths={[380, 760]}
    class="rounded-none"
  />
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-(length:--text-h3) leading-(--text-h3--line-height)">{data.title}</h3>
    <p class="mt-2 line-clamp-3 flex-1 text-(--color-muted)">{data.summary}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        data.tags
          .slice(0, 3)
          .map((tag) => (
            <Chip label={tagLabels.get(tag)?.label ?? tag} color={tagLabels.get(tag)?.color} />
          ))
      }
    </div>
  </div>
</a>
