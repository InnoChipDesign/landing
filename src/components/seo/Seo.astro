---
/**
 * Every `<head>` tag that is about this page rather than about the site (07-seo.md §1).
 *
 * Props are required rather than defaulted, so `astro check` fails a page that ships without a
 * title or a description. A defaulted description is worse than none: it looks correct in the
 * markup and produces a search result that describes some other page.
 *
 * Telegram is the club's main channel and renders `og:*` for pasted links, which makes the OG card
 * the most-seen surface on the site — ahead of any actual page. That is why the `og:` block here is
 * more complete than the `twitter:` one, rather than the other way round.
 */
import { site } from '../../data/site';

interface Props {
  /** Without the site-name suffix. ≤ 60 characters. */
  title: string;
  /** 120–160 characters. Never auto-truncated body prose. */
  description: string;
  /** Defaults to this page's own URL resolved against `site`. */
  canonical?: string;
  /** Absolute or root-relative. Resolved against `site`, because a relative OG URL yields no card. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  /** A `@graph` string from `src/lib/seo.ts`. */
  jsonLd?: string;
}

const {
  title,
  description,
  canonical,
  image = '/og/default.png',
  imageAlt,
  type = 'website',
  noindex = false,
  publishedAt,
  updatedAt,
  jsonLd,
} = Astro.props;

// `Astro.site` is the SITE_URL build arg. A build cannot start without it (astro.config.mjs), so
// every URL below is absolute — the single most common way OG cards silently fail is a relative one.
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// The portal's own name stands alone; everything else is suffixed. `/club` passes the tagline as
// its title, so its <title> reads as a description rather than as "InnoChipDesign — InnoChipDesign".
const fullTitle = title === site.name ? title : `${title} — ${site.name}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content="en" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? `${title} — ${site.name}`} />

{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} is:inline />}
