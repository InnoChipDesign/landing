---
/**
 * The club mark reduced to ONE colour, inheriting `currentColor`.
 *
 * Why this exists alongside `Logo.astro`: the real mark is reversed — a green field with a white
 * knock-out — and that is right wherever the mark sits on its own. It is wrong inside the cover
 * stub, whose whole background is a per-slug hue (04 §A2); a saturated green square dropped into a
 * rose or amber tint reads as a rendering bug, not as branding.
 *
 * The reduction is the honest one for a reversed mark: the green becomes `currentColor` and the
 * white knock-out becomes transparent, so the glyph picks up `--stub-fg` and every stub stays
 * monochrome. Geometry is identical to `logo.svg` — if that file changes, change this too.
 *
 * Use `Logo` by default. Use this only where the mark must take a colour from its surroundings.
 */
interface Props {
  class?: string;
}
const { class: className = 'size-8' } = Astro.props;

// A page renders one stub per project row, so the mask id must be unique per instance or every
// stub after the first inherits the first one's mask.
const id = `glyph-${Math.random().toString(36).slice(2, 9)}`;
---

<svg viewBox="0 0 640 640" class={className} aria-hidden="true" role="presentation">
  <mask id={id}>
    <rect width="640" height="640" fill="#fff" />
    <g fill="#000">
      <rect x="175" y="0" width="58" height="58.908" />
      <rect x="291" y="0" width="58" height="58.908" />
      <rect x="408" y="0" width="58" height="58.908" />
      <rect x="175" y="58.908" width="291" height="57.9095" />
      <rect x="0" y="174.727" width="59" height="57.9095" />
      <rect x="0" y="407.364" width="59" height="57.9095" />
      <rect x="59" y="174.727" width="58" height="290.546" />
      <rect x="581" y="174.727" width="59" height="57.9095" />
      <rect x="581" y="407.364" width="59" height="57.9095" />
      <rect x="523" y="174.727" width="58" height="290.546" />
      <rect x="175" y="174.727" width="291" height="57.9095" />
      <rect x="175" y="232.636" width="58" height="173.729" />
      <rect x="408" y="232.636" width="58" height="173.729" />
      <rect x="175" y="406.365" width="291" height="57.9095" />
      <rect x="291" y="290.546" width="58" height="58.908" />
      <rect x="175" y="523.183" width="291" height="57.9095" />
      <rect x="408" y="523.183" width="58" height="116.817" />
    </g>
  </mask>
  <rect width="640" height="640" fill="currentColor" mask={`url(#${id})`} />
</svg>
