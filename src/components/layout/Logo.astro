---
/**
 * The club mark, inlined as SVG (never an <img>, so it costs no request and scales crisply).
 *
 * It carries its own green ground rather than inheriting `currentColor`, which is why there is no
 * dark-mode variant and no colour prop: a reversed mark is correct on both themes as-is, and
 * tinting it to the link accent would render a shape the club has never used.
 */
import logo from '../../assets/logo.svg';

interface Props {
  class?: string;
}
const { class: className = 'size-7' } = Astro.props;
const Mark = logo;
---

<Mark class={`rounded-[0.15em] ${className}`} aria-hidden="true" role="presentation" />
