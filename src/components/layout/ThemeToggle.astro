---
/**
 * Light is the default; the choice persists in localStorage and is applied before first paint by
 * the blocking script in BaseLayout, so there is no flash.
 *
 * Astro component + ~10 lines of inline script — tier 2 of the rendering model (01 §4). Hydrating
 * a framework for one class toggle would put Preact on all eleven routes.
 */
import { Icon } from 'astro-icon/components';
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex size-11 items-center justify-center rounded-(--radius-full) text-(--color-muted) transition-colors duration-(--dur-fast) hover:bg-(--color-surface-2) hover:text-(--color-text)"
  aria-label="Switch to dark theme"
  aria-live="polite"
>
  <Icon name="lucide:moon" class="size-5 dark:hidden" aria-hidden="true" />
  <Icon name="lucide:sun" class="hidden size-5 dark:block" aria-hidden="true" />
</button>

<script>
  const root = document.documentElement;

  function label(): string {
    return root.classList.contains('dark') ? 'Switch to light theme' : 'Switch to dark theme';
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.setAttribute('aria-label', label());
    button.addEventListener('click', () => {
      const dark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        /* Preference is not persisted in a locked-down browser; the toggle still works. */
      }
      for (const other of document.querySelectorAll('[data-theme-toggle]')) {
        other.setAttribute('aria-label', label());
      }
    });
  }
</script>
