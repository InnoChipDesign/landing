---
/** Four columns collapsing to one on mobile (05 §3). Club zone only — the portal has no footer nav. */
import { Icon } from 'astro-icon/components';
import Container from './Container.astro';
import Logo from './Logo.astro';
import { site } from '../../data/site';
import { routes } from '../../lib/routes';
import { footerLinks, headerServices } from '../../lib/nav';

const links = await footerLinks();
const services = await headerServices();
const year = new Date().getFullYear();
const { address } = site.contact;
---

<footer class="mt-auto border-t border-(--color-border) bg-(--color-surface)">
  <Container class="py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2 font-(family-name:--font-display) text-lg font-semibold">
          <Logo class="size-6" />
          {site.name}
        </div>
        <p class="mt-3 text-(length:--text-meta) text-(--color-muted)">{site.tagline}</p>
        <p class="mt-3 text-(length:--text-meta) text-(--color-muted)">
          {site.university.name} · since {site.foundedYear}
        </p>
      </div>

      <nav aria-label="Site">
        <h2 class="text-(length:--text-meta) font-semibold tracking-wide uppercase">Site</h2>
        <ul class="mt-3 flex flex-col gap-2 text-(length:--text-meta) text-(--color-muted)">
          {
            links.map((item) => (
              <li>
                <a href={item.href} class="hover:text-(--color-text)">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Our sites">
        <h2 class="text-(length:--text-meta) font-semibold tracking-wide uppercase">Our sites</h2>
        <ul class="mt-3 flex flex-col gap-2 text-(length:--text-meta) text-(--color-muted)">
          <li>
            <a href={routes.portal()} class="inline-flex items-center gap-1 hover:text-(--color-text)">
              <Icon name="lucide:arrow-up-left" class="size-3.5" aria-hidden="true" />
              All sites
            </a>
          </li>
          {
            services.map((service) => (
              <li>
                <a
                  href={service.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${service.data.name} — opens in a new tab`}
                  class="inline-flex items-center gap-1 hover:text-(--color-text)"
                >
                  {service.data.name}
                  <Icon name="lucide:arrow-up-right" class="size-3.5" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-(length:--text-meta) font-semibold tracking-wide uppercase">Reach us</h2>
        <ul class="mt-3 flex flex-col gap-2 text-(length:--text-meta) text-(--color-muted)">
          <li>
            <a
              href={site.contact.chat}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-(--color-text)"
            >
              Telegram
            </a>
          </li>
          <li>
            <a href={`mailto:${site.contact.email}`} class="break-all hover:text-(--color-text)">
              {site.contact.email}
            </a>
          </li>
          <li>{address.street}, {address.locality}</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-(--color-border) pt-6 text-(length:--text-meta) text-(--color-muted) sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.fullName} · {site.university.name}</p>
      <a
        href={site.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 hover:text-(--color-text)"
      >
        Source on GitHub
        <Icon name="lucide:arrow-up-right" class="size-3.5" aria-hidden="true" />
      </a>
    </div>
  </Container>
</footer>
