---
/**
 * Deliberately NOT an island (01 §4). It is an Astro component with ~30 lines of inline script
 * around a native <dialog>. Making it an island would drag Preact onto every one of the eleven
 * routes for a menu toggle.
 *
 * `showModal()` gives focus trapping and Esc-to-close for free — that is the whole reason for
 * using the native element rather than a styled <div>.
 */
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { routes } from '../../lib/routes';

interface Props {
  nav: { label: string; href: string }[];
  services: CollectionEntry<'services'>[];
}

const { nav, services } = Astro.props;
---

<button
  type="button"
  data-menu-open
  aria-haspopup="dialog"
  aria-label="Open menu"
  class="inline-flex size-11 items-center justify-center rounded-(--radius-full) text-(--color-muted) transition-colors duration-(--dur-fast) hover:bg-(--color-surface-2) hover:text-(--color-text) lg:hidden"
>
  <Icon name="lucide:menu" class="size-5" aria-hidden="true" />
</button>

<dialog
  data-menu
  aria-label="Site menu"
  class="m-0 ml-auto h-dvh max-h-none w-full max-w-sm bg-(--color-bg) p-0 text-(--color-text) backdrop:bg-black/40"
>
  <div class="flex h-full flex-col">
    <div class="flex h-16 items-center justify-between border-b border-(--color-border) px-4">
      <span class="font-(family-name:--font-display) text-lg font-semibold">Menu</span>
      <button
        type="button"
        data-menu-close
        aria-label="Close menu"
        class="inline-flex size-11 items-center justify-center rounded-(--radius-full) text-(--color-muted) hover:bg-(--color-surface-2) hover:text-(--color-text)"
      >
        <Icon name="lucide:x" class="size-5" aria-hidden="true" />
      </button>
    </div>

    <nav aria-label="Club" class="flex-1 overflow-y-auto p-4">
      <ul class="flex flex-col gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex min-h-11 items-center rounded-(--radius-sm) px-3 font-medium hover:bg-(--color-surface-2)"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={routes.contact()}
            class="flex min-h-11 items-center rounded-(--radius-sm) px-3 font-medium hover:bg-(--color-surface-2)"
          >
            Contact
          </a>
        </li>
      </ul>

      <hr class="my-4 border-(--color-border)" />

      <ul class="flex flex-col gap-1">
        {
          services.map((service) => (
            <li>
              <a
                href={service.data.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${service.data.name} — opens in a new tab`}
                class="flex min-h-11 items-center gap-2 rounded-(--radius-sm) px-3 font-medium hover:bg-(--color-surface-2)"
              >
                {service.data.name}
                <Icon name="lucide:arrow-up-right" class="size-4 text-(--color-muted)" aria-hidden="true" />
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={routes.portal()}
            class="flex min-h-11 items-center gap-2 rounded-(--radius-sm) px-3 text-(--color-muted) hover:bg-(--color-surface-2)"
          >
            <Icon name="lucide:arrow-up-left" class="size-4" aria-hidden="true" />
            All sites
          </a>
        </li>
      </ul>
    </nav>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (dialog && openButton && closeButton) {
    const open = () => {
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      dialog.close();
    };

    openButton.addEventListener('click', open);
    closeButton.addEventListener('click', close);

    // Restores scroll for every close path — the button, Esc, and the backdrop below.
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      openButton.focus();
    });

    // <dialog> does not distinguish a backdrop click from a content click, so compare against the
    // dialog's own box.
    dialog.addEventListener('click', (event) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) close();
    });
  }
</script>
