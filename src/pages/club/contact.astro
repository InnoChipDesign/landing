---
/**
 * `/club/contact`.
 *
 * No contact form: there is no backend and no form service, so a form here would either lie or
 * introduce a third-party dependency. The chat and the email address are the real channels, and
 * both are faster than a form anyway.
 *
 * The map is a clickable static image, never a live embed — an embed loads a tracking-capable
 * script and would cost the site its zero-third-party-requests property. The address is also
 * printed as text, so the map is never the only way to get the information.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';

import { site } from '~/data/site';

const { address } = site.contact;
const addressLine = `${address.street}, ${address.locality}, ${address.region}, ${address.postalCode}`;

const metadata = {
  title: 'Contact',
  description: 'Joining or a question about a session? The chat. Press or collaboration? Email.',
};
---

<PageLayout metadata={metadata}>
  <HeroText tagline="Contact">
    <Fragment slot="title">Contact</Fragment>
    <Fragment slot="subtitle">
      Joining, or a question about a session? Use the chat — it is where everyone actually is. Press or collaboration?
      Email.
    </Fragment>
  </HeroText>

  <Features2
    columns={2}
    items={[
      {
        title: 'Telegram',
        description: 'The club chat. Session rooms, topics and questions.',
        icon: 'tabler:brand-telegram',
        callToAction: { text: 'Open the chat', href: site.contact.chat, target: '_blank' },
      },
      {
        title: 'Email',
        description: site.contact.email,
        icon: 'tabler:mail',
        callToAction: { text: 'Send an email', href: `mailto:${site.contact.email}` },
      },
      {
        title: 'GitHub',
        description: 'Every project the club publishes, with its source.',
        icon: 'tabler:brand-github',
        callToAction: { text: 'View the organisation', href: site.repoUrl, target: '_blank' },
      },
      {
        title: 'Faculty advisor',
        description: `${site.advisor.name} — ${site.advisor.role}, ${site.university.name}.`,
        icon: 'tabler:user-star',
      },
    ]}
  />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
    <div class="mx-auto grid max-w-4xl items-center gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-(length:--text-h2) leading-(--text-h2--line-height) font-bold">Where we are</h2>
        <address class="mt-4 text-lg text-muted not-italic">
          {address.street}<br />
          {address.locality}, {address.region}<br />
          {address.postalCode}
        </address>
        <p class="mt-4 text-muted">
          The room is announced in the Telegram chat before each session — it is never fixed.
        </p>
      </div>

      {
        /* 🔴 PLACEHOLDER — a real static map screenshot with the building marked was specified but
          never supplied. Until it is, this is a labelled link rather than a fake map. */
      }
      <a
        href={site.contact.mapLink}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-52 flex-col items-center justify-center rounded-(--radius-lg) border border-(--club-border) bg-surface p-8 text-center transition duration-200 hover:border-primary/40 hover:shadow-(--shadow-md)"
      >
        <Icon name="tabler:map-pin" class="size-8 text-primary" />
        <span class="mt-4 flex items-center gap-1 font-semibold">
          Open in Yandex Maps
          <Icon name="tabler:arrow-up-right" class="size-4 text-muted" />
        </span>
        <span class="mt-2 text-sm text-muted">{addressLine}</span>
      </a>
    </div>
  </section>

  <CallToAction actions={[{ variant: 'primary', text: 'How to join', href: '/club/join' }]}>
    <Fragment slot="title">Just want to come along?</Fragment>
    <Fragment slot="subtitle">
      {`${site.meetings.recurrence} ${site.meetings.season}. ${site.meetings.locationNote}`}
    </Fragment>
  </CallToAction>
</PageLayout>
