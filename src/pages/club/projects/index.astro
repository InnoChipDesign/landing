---
/**
 * `/club/projects` — the directory.
 *
 * The COMPLETE list is server-rendered, newest first (D20/D22). With JavaScript disabled a visitor
 * still sees every project and can navigate to any of them — a hard requirement, not a nicety
 * (01 §4), and also what makes the page indexable.
 *
 * The `ProjectExplorer` island (query box, three facet groups, sort, `aria-live` count) enhances
 * this list — it reads these rows and reorders and hides them. It never renders a row itself, so
 * there is no second copy of `ProjectRow` to drift out of sync, and no code path in which the
 * island can swallow the server-rendered list.
 *
 * `data-pagefind-ignore` keeps this index page out of the search index — Pagefind indexes the
 * project pages, and indexing the list too would return the same content twice (03 §2).
 */
import ClubLayout from '../../../layouts/ClubLayout.astro';
import Container from '../../../components/layout/Container.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import ProjectRow from '../../../components/project/ProjectRow.astro';
import ProjectExplorer, { type RowData } from '../../../components/project/ProjectExplorer';
import EmptyState from '../../../components/ui/EmptyState.astro';
import { publishedProjects, tagLabels } from '../../../lib/projects';
import { STATUS_LABELS } from '../../../lib/format';

const projects = await publishedProjects();
const labels = await tagLabels();

// The chips read "RISC-V" while the URL carries `riscv`. Passed in rather than looked up in the
// island, so the tag vocabulary stays a build-time concern (D25) and the island ships no copy of it.
const chipLabels = Object.fromEntries([...labels].map(([id, tag]) => [id, tag.label]));

// The filter index, in the same order the rows are rendered — which is the `newest` sort. Passing
// it as props rather than letting the island scrape the DOM is what lets the whole control bar
// render on the server, so it does not appear a frame late on the site's busiest page.
const explorerRows: RowData[] = projects.map((project) => ({
  slug: project.id,
  title: project.data.title,
  tags: [...project.data.tags],
  year: String(project.data.year),
  status: project.data.status,
}));
---

<ClubLayout
  title="Projects"
  description="Digital hardware built by members of the Innopolis Chip Design Club — RISC-V cores, FPGA designs, memory subsystems, verification work and more."
>
  <div data-pagefind-ignore>
    <PageHeader
      title="Projects"
      lead={`Everything the club has built and published — ${projects.length} project${projects.length === 1 ? '' : 's'}, newest first.`}
    />

    <Container class="pb-20">
      {
        projects.length === 0 ? (
          <EmptyState title="No projects published yet">
            Add one by copying <code>templates/project/</code> into{' '}
            <code>src/content/projects/&lt;slug&gt;/</code> and opening a pull request.
          </EmptyState>
        ) : (
          <>
            {/* `client:load`, not `client:idle`: this island IS the page's primary interaction, and
                a shared `?tags=riscv` link must resolve to the filtered view on first paint rather
                than flashing all 3 projects and then narrowing. */}
            <ProjectExplorer
              client:load
              projects={explorerRows}
              tagLabels={chipLabels}
              statusLabels={STATUS_LABELS}
            />
            <ul class="mt-8 border-t border-(--color-border)" data-project-list>
              {projects.map((project) => (
                <ProjectRow project={project} tagLabels={labels} />
              ))}
            </ul>
          </>
        )
      }
    </Container>
  </div>
</ClubLayout>
