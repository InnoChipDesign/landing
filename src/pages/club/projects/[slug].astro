---
/**
 * `/club/projects/<slug>` — the project detail page (D5, 05 §6).
 *
 * A real static HTML document per project: required for SEO, for shareable links, for the
 * per-project OG image, and it is what Pagefind indexes.
 *
 * Every sidebar block is omitted entirely when its data is empty — no "Awards: none".
 * Team credits are plain text unless the person supplied a link of their own. They are NEVER a
 * link to a site filter: the team facet was removed because teams are per-project (D7/D8).
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';

import ClubLayout from '../../../layouts/ClubLayout.astro';
import Container from '../../../components/layout/Container.astro';
import Prose from '../../../components/ui/Prose.astro';
import Chip from '../../../components/ui/Chip.astro';
import StatusPill from '../../../components/ui/StatusPill.astro';
import ProjectCover from '../../../components/project/ProjectCover.astro';
import ProjectCard from '../../../components/project/ProjectCard.astro';
import VideoFacade from '../../../components/media/VideoFacade.astro';
import Gallery from '../../../components/media/Gallery.astro';

import { routes } from '../../../lib/routes';
import { formatTerm } from '../../../lib/format';
import { publishedProjects, tagLabels, relatedProjects, type Project } from '../../../lib/projects';

interface Props {
  project: Project;
}

export const getStaticPaths: GetStaticPaths = async () => {
  // `draft: true` projects are excluded here, so a draft never gets a URL and never enters the
  // search index (02 §2).
  const projects = await publishedProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
};

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const labels = await tagLabels();
const all = await publishedProjects();
const related = relatedProjects(project, all);
const people = await getCollection('people');
const peopleById = new Map(people.map((p) => [p.id, p.data]));

const LINK_LABELS: Record<string, string> = {
  repo: 'Repository',
  docs: 'Documentation',
  paper: 'Paper',
  poster: 'Poster',
  demo: 'Live demo',
};
const links = Object.entries(data.links).filter(([, url]) => !!url) as [string, string][];
const hasSidebar =
  data.team.length > 0 ||
  links.length > 0 ||
  data.stack.length > 0 ||
  data.hardware.length > 0 ||
  data.awards.length > 0;
---

<ClubLayout
  title={data.title}
  description={data.summary}
  image={routes.og(project.id)}
  ogType="article"
>
  <Container class="py-12">
    <a
      href={routes.projects()}
      class="inline-flex items-center gap-1 text-(length:--text-meta) text-(--color-muted) hover:text-(--color-text)"
    >
      <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
      All projects
    </a>

    {/* The Pagefind markup contract (03 §2). These attributes are a CONTRACT: changing them
        without updating src/lib/search.ts breaks search silently, which is why they are specced
        and why smoke test 1–6 exists. Everything findable by text must sit inside this element —
        title, summary, tags, stack, hardware, awards, TEAM MEMBER NAMES and the prose. Member
        names being in here is what makes the removed team facet (D7) cost nothing. */}
    <article
      class="mt-8"
      data-pagefind-body
      data-pagefind-filter="tag[data-tags], year[data-year], status[data-status]"
      data-pagefind-sort="year[data-year], title[data-title]"
      data-tags={data.tags[0]}
      data-year={data.year}
      data-status={data.status}
      data-title={data.title}
    >
      {/* Pagefind takes one value per tagged element, so a multi-valued facet needs one element
          per value. `aria-hidden` as well as `sr-only`: this is machine data, not content for a
          screen reader — the visible chips below already convey it. */}
      <ul class="sr-only" aria-hidden="true">
        {data.tags.map((tag) => <li data-pagefind-filter="tag">{tag}</li>)}
      </ul>
      <span class="sr-only" aria-hidden="true" data-pagefind-meta="year">{data.year}</span>
      {
        data.semester && (
          <span class="sr-only" aria-hidden="true" data-pagefind-meta="semester">
            {data.semester}
          </span>
        )
      }
      <span class="sr-only" aria-hidden="true" data-pagefind-meta="status">{data.status}</span>
      {
        data.video && (
          <span class="sr-only" aria-hidden="true" data-pagefind-meta="hasVideo">
            1
          </span>
        )
      }
      {/* TODO(phase 4) — `image` meta. When a project HAS a cover this can hang off the rendered
          <img>; when it does not, D21 requires emitting the generated stub as a data URI so
          client-rendered results align with the server-rendered rows instead of leaving a hole.
          Nothing consumes this meta until the ProjectExplorer island exists, so it is deliberately
          absent rather than half-right. */}

      <header class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-(--spacing-prose)">
          <h1
            class="text-(length:--text-display) leading-(--text-display--line-height)"
            data-pagefind-meta="title"
          >
            {data.title}
          </h1>
          <p class="mt-4 text-(length:--text-lead) text-(--color-muted)" data-pagefind-meta="summary">
            {data.summary}
          </p>
        </div>

        <div class="flex shrink-0 flex-wrap items-center gap-3 lg:flex-col lg:items-end">
          <span class="text-(length:--text-meta) text-(--color-muted)">
            {formatTerm(data.year, data.semester)}
          </span>
          <StatusPill status={data.status} />
          <div class="flex flex-wrap gap-2 lg:justify-end">
            {
              data.tags.map((tag) => (
                <Chip label={labels.get(tag)?.label ?? tag} color={labels.get(tag)?.color} />
              ))
            }
          </div>
        </div>
      </header>

      <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
        <div class="min-w-0">
          {/* Demos are the reason visitors came, so the video sits directly under the summary,
              above the body prose. With no video, the cover takes the slot — the layout does not
              leave a hole (04 §B4). */}
          {
            data.video ? (
              <VideoFacade
                url={data.video}
                title={data.videoTitle}
                poster={data.videoPoster ?? data.cover}
                posterAlt={data.coverAlt}
                slug={project.id}
                projectTitle={data.title}
              />
            ) : (
              <ProjectCover
                slug={project.id}
                title={data.title}
                image={data.cover}
                alt={data.coverAlt}
                aspect="16/9"
                sizes="(min-width: 1024px) 760px, 100vw"
                widths={[640, 1280]}
                loading="eager"
              />
            )
          }

          <Prose class="mt-10">
            <Content />
          </Prose>

          <Gallery slug={project.id} items={data.gallery} />
        </div>

        {
          hasSidebar && (
            <aside class="flex flex-col gap-8 text-(length:--text-meta)">
              {data.team.length > 0 && (
                <section>
                  <h2 class="font-semibold tracking-wide uppercase">Team</h2>
                  <ul class="mt-3 flex flex-col gap-2">
                    {data.team.map((credit) => {
                      const person = credit.person ? peopleById.get(credit.person.id) : undefined;
                      const name = person?.name ?? credit.name ?? 'Unnamed contributor';
                      const role = credit.role ?? person?.role;
                      const href = person?.links.github ?? person?.links.site;
                      return (
                        <li>
                          {href ? (
                            <a
                              href={href}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-(--color-accent) hover:underline"
                            >
                              {name}
                            </a>
                          ) : (
                            <span>{name}</span>
                          )}
                          {role && <span class="text-(--color-muted)"> · {role}</span>}
                        </li>
                      );
                    })}
                  </ul>
                </section>
              )}

              {links.length > 0 && (
                <section>
                  <h2 class="font-semibold tracking-wide uppercase">Links</h2>
                  <ul class="mt-3 flex flex-col gap-2">
                    {links.map(([key, url]) => (
                      <li>
                        <a
                          href={url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 text-(--color-accent) hover:underline"
                        >
                          {LINK_LABELS[key] ?? key}
                          <Icon name="lucide:arrow-up-right" class="size-3.5" aria-hidden="true" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {(data.stack.length > 0 || data.hardware.length > 0) && (
                <section>
                  <h2 class="font-semibold tracking-wide uppercase">Tech</h2>
                  <p class="mt-3 text-(--color-muted)">
                    {[...data.stack, ...data.hardware].join(' · ')}
                  </p>
                </section>
              )}

              {data.awards.length > 0 && (
                <section>
                  <h2 class="font-semibold tracking-wide uppercase">Awards</h2>
                  <ul class="mt-3 flex flex-col gap-2">
                    {data.awards.map((award) => (
                      <li class="flex gap-2">
                        <Icon
                          name="lucide:trophy"
                          class="mt-0.5 size-4 shrink-0 text-(--color-warm)"
                          aria-hidden="true"
                        />
                        <span>
                          {award.title}
                          {award.event && <span class="text-(--color-muted)"> · {award.event}</span>}
                          {award.year && <span class="text-(--color-muted)"> {award.year}</span>}
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </aside>
          )
        }
      </div>
    </article>

    {
      related.length > 0 && (
        <section aria-labelledby="related-heading" class="mt-20" data-pagefind-ignore>
          <h2 id="related-heading" class="text-(length:--text-h2) leading-(--text-h2--line-height)">
            Related projects
          </h2>
          <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((entry) => (
              <li class="flex">
                <ProjectCard project={entry} tagLabels={labels} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </Container>
</ClubLayout>
