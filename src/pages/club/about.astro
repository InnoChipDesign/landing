---
/**
 * `/club/about`.
 *
 * Two things this page deliberately does and does not do:
 *   · it says the 2024 SoC Design Challenge result was "placed", not "won", because the track and
 *     placement are unverified. Fill in the specifics and the sentence gets stronger, not weaker.
 *   · it does not claim a member count, which the deliberately partial roster cannot support.
 *
 * Still missing: a history/timeline section — the leader left it blank.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';

import { site } from '~/data/site';

const metadata = {
  title: 'About',
  description: `A student engineering community at ${site.university.name}, building digital hardware since ${site.foundedYear}.`,
};
---

<PageLayout metadata={metadata}>
  <HeroText tagline="About">
    <Fragment slot="title">About the club</Fragment>
    <Fragment slot="subtitle">
      A student engineering community at {site.university.name}, building digital hardware since {site.foundedYear}.
    </Fragment>
  </HeroText>

  <Content
    title="What we are"
    content={`<p>${site.name} is a student engineering community at ${site.university.name}. We formed in ${site.foundedYear} around a simple idea: that the way to understand how a processor works is to build one. Our members design digital hardware — writing RTL, running it on FPGA boards, verifying it, and taking the better projects toward an ASIC flow.</p>`}
  />

  <Content
    isReversed
    title="How we work"
    content={`<p>We meet ${site.meetings.recurrence.toLowerCase()} ${site.meetings.season}. Sessions follow the Chip Design School curriculum run by YADRO with MIET, MFTI and ITMO — a free two-semester course covering logic design, state machines, FPGA architecture, pipelines, microarchitecture and functional verification.</p><p class="mt-4">Around that, members build their own projects: RISC-V cores, cache and memory subsystems, audio and video pipelines, and a long line of games that turn out to be an excellent way to learn timing closure. Every project ends up on GitHub.</p>`}
  />

  <Content
    title="Where it leads"
    content={`<p>${site.competition.record} It is an in-person RISC-V systems-on-chip hackathon at MIET in Zelenograd, with tracks in topological design, RTL, UVM verification, system verification and design-for-test.</p><p class="mt-4">Chip design is a field that is actively building capacity, and the gap between a university course and industry work is mostly practice. That practice is what this club is for.</p>`}
    callToAction={{
      text: 'About the SoC Design Challenge',
      href: site.competition.url,
      icon: 'tabler:external-link',
    }}
  />

  <Features2
    title="Who runs it"
    columns={2}
    items={[
      {
        title: site.advisor.name,
        description: `${site.advisor.role}, ${site.university.name}. Faculty advisor to the club.`,
        icon: 'tabler:user-star',
      },
      {
        title: 'The members',
        description:
          'The club is run by its students. Project credits are listed with each project as it is published.',
        icon: 'tabler:users-group',
      },
    ]}
  />

  {
    /* Partners. Rendered only alongside at least one real partner — the open invitation on its own
      reads as "nobody works with us". */
  }
  {
    site.partners.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16">
        <h2 class="mb-8 text-center text-(length:--text-h2) leading-(--text-h2--line-height) font-bold">Partners</h2>
        <div class="mx-auto grid max-w-3xl gap-5 sm:grid-cols-2">
          {site.partners.map((partner) => (
            <a
              href={partner.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col rounded-(--radius-lg) border border-(--club-border) bg-page p-6 shadow-(--shadow-sm) transition duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-(--shadow-md)"
            >
              {/* 🔴 UNCONFIRMED: the relationship and the preferred credit wording. A wrongly-worded
                  credit for a company is worse than no credit — confirm before launch. */}
              <span class="flex items-center gap-1 text-lg font-semibold">
                {partner.name}
                <Icon name="tabler:arrow-up-right" class="size-4 text-muted" />
              </span>
              <span class="mt-1 text-sm text-muted">{partner.legalName}</span>
              <span class="mt-3 text-muted">{partner.note}</span>
            </a>
          ))}

          {site.partnerInvite.enabled && (
            <a
              href={`mailto:${site.partnerInvite.mailto}`}
              class="flex flex-col justify-center rounded-(--radius-lg) border border-dashed border-(--club-border) p-6 transition duration-200 hover:border-primary/50"
            >
              <span class="text-lg font-semibold">{site.partnerInvite.heading}</span>
              <span class="mt-3 text-muted">{site.partnerInvite.body}</span>
            </a>
          )}
        </div>
      </section>
    )
  }

  <CallToAction
    actions={[
      { variant: 'primary', text: 'How to join', href: '/club/join' },
      { text: 'Contact us', href: '/club/contact' },
    ]}
  >
    <Fragment slot="title">Want in?</Fragment>
    <Fragment slot="subtitle">Everyone is welcome, and no application is required to show up.</Fragment>
  </CallToAction>
</PageLayout>
