---
/**
 * `/club/join` — the page it matters most to get right.
 *
 * The load-bearing part is the Note: the primary call to action points at YADRO's Chip Design
 * School, a third party's programme, NOT a club membership form. Drop that framing and a visitor
 * who wanted to join the club on Saturday lands on an unrelated school signup and is confused.
 *
 * "Just come on Saturday" is deliberate and should survive editing: a form as the only path filters
 * out exactly the shy first-years a student club most wants to reach.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Note from '~/components/widgets/Note.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { site } from '~/data/site';

const metadata = {
  title: 'Join the club',
  description: 'Everyone is welcome. No selection, no prior experience, and no application required to show up.',
};
---

<PageLayout metadata={metadata}>
  <HeroText tagline="Join">
    <Fragment slot="title">Join the club</Fragment>
    <Fragment slot="subtitle">
      Everyone is welcome. There is no selection process and no prior experience required — several current members
      started by turning up.
    </Fragment>
  </HeroText>

  <Note
    icon="tabler:info-circle"
    title="Before you click step 1:"
    description="The Chip Design School is a free course run by YADRO with MIET, MFTI and ITMO — not a club application. Our Saturday sessions follow its curriculum, which is why we point you at it. Joining the club itself takes no form at all."
  />

  <Steps
    title="How it works"
    items={[
      {
        title: site.join.formLabel,
        description:
          'The free YADRO/MIET course our Saturday sessions follow. Opens on their site — it is their programme, not ours.',
        icon: 'tabler:external-link',
      },
      {
        title: 'Join the Telegram chat',
        description: 'Where the room and the week&rsquo;s topic are posted before each session.',
        icon: 'tabler:brand-telegram',
      },
      {
        title: 'Just come on Saturday',
        description: `${site.meetings.recurrence} ${site.meetings.season}. No application is required to show up.`,
        icon: 'tabler:door-enter',
      },
    ]}
  />

  <Features2
    title="What you'll do"
    columns={3}
    items={[
      {
        title: 'Write RTL that runs',
        description: 'Digital design on real FPGA hardware, not only in simulation.',
        icon: 'tabler:code',
      },
      {
        title: 'Build something of your own',
        description: 'A project you choose, published here and on GitHub.',
        icon: 'tabler:tools',
      },
      {
        title: 'Compete, if you want to',
        description: `Work toward the ${site.competition.name}. Entirely optional.`,
        icon: 'tabler:trophy',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: site.join.formLabel,
        href: site.join.formUrl,
        target: '_blank',
        icon: 'tabler:external-link',
      },
      { text: 'Ask in Telegram', href: site.join.chatUrl, target: '_blank', icon: 'tabler:brand-telegram' },
    ]}
  >
    <Fragment slot="title">Still not sure?</Fragment>
    <Fragment slot="subtitle">
      Ask in the chat, or simply turn up on a Saturday and see what we are working on.
    </Fragment>
  </CallToAction>
</PageLayout>
