---
/**
 * `/club` — the club home.
 *
 * Order: what we do → what we are → come along. The project showcase that would normally open this
 * page is absent because the projects collection is not part of this round; when it lands it goes
 * above "What we do", not below.
 *
 * No Stats band. The numbers it would show (project count, member count) can only be hand-typed
 * today, and a row of hand-maintained figures is exactly the marketing noise this design avoids.
 * It earns its place once the collection can derive them.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { site } from '~/data/site';

const metadata = {
  title: site.fullName,
  ignoreTitleTemplate: true,
  description: site.tagline,
};
---

<PageLayout metadata={metadata}>
  <Hero
    tagline={`${site.university.name} · Since ${site.foundedYear}`}
    actions={[
      { variant: 'primary', text: 'Join the club', href: '/club/join' },
      { text: 'See our work', href: site.repoUrl, target: '_blank', icon: 'tabler:brand-github' },
    ]}
  >
    <Fragment slot="title">{site.fullName}</Fragment>
    <Fragment slot="subtitle">{site.pitch}</Fragment>
  </Hero>

  <Features2
    title="What we do"
    subtitle="Digital hardware, from a first state machine to a taped-out flow."
    columns={4}
    items={[
      {
        title: 'FPGA',
        description: 'Designs that run on real boards, not only in simulation.',
        icon: 'tabler:cpu',
      },
      {
        title: 'RISC-V & CPU design',
        description: 'Building processors is how the rest of it starts to make sense.',
        icon: 'tabler:binary',
      },
      {
        title: 'Verification',
        description: 'Testbenches, golden models and the discipline of proving a design works.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'ASIC flows',
        description: 'Taking the better projects toward what a chip actually needs.',
        icon: 'tabler:stack-2',
      },
    ]}
  />

  <Content
    title="What we are"
    content={`<p>${site.name} is a student engineering community at ${site.university.name}. We formed in ${site.foundedYear} around a simple idea: that the way to understand how a processor works is to build one. Our members design digital hardware — writing RTL, running it on FPGA boards, verifying it, and taking the better projects toward an ASIC flow.</p><p class="mt-4">${site.competition.record}</p>`}
    callToAction={{ text: 'More about the club', href: '/club/about', icon: 'tabler:chevron-right' }}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: 'How to join', href: '/club/join' },
      { text: 'Telegram chat', href: site.contact.chat, target: '_blank', icon: 'tabler:brand-telegram' },
    ]}
  >
    <Fragment slot="title">Come along</Fragment>
    <Fragment slot="subtitle">
      {`${site.meetings.recurrence} ${site.meetings.season}. ${site.meetings.locationNote}`}
    </Fragment>
  </CallToAction>
</PageLayout>
