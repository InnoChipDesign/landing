---
/**
 * Two exits, not one. A 404 that only offers the portal is a dead end for someone who mistyped a
 * club URL — they wanted a page on the club site, so send them there as well as to the switchboard.
 */
import Layout from '~/layouts/Layout.astro';

const title = 'Page not found';
---

<Layout metadata={{ title }}>
  <section class="flex h-full items-center p-16">
    <div class="container mx-auto my-8 flex flex-col items-center justify-center px-5">
      <div class="max-w-md text-center">
        <h1 class="mb-8 text-8xl font-bold">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h1>
        <p class="text-2xl font-semibold md:text-3xl">We couldn't find that page.</p>
        <p class="mt-4 mb-8 text-lg text-muted">
          It may have moved, or the link may be wrong. Both ways back are below.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/club" class="btn-primary">Go to the club site</a>
          <a href="/" class="btn">All properties</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
