---
/**
 * A scratch route for building the UI primitives in isolation (09, phase 1).
 *
 * Excluded from the sitemap and marked noindex. Phase 1's "done when" is this page: every
 * primitive rendering in light AND dark, keyboard-navigable, with zero framework JS shipped.
 * Delete it once the site is finished, or keep it — it is the cheapest regression check there is
 * for a token change.
 */
import ClubLayout from '../layouts/ClubLayout.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Chip from '../components/ui/Chip.astro';
import StatusPill from '../components/ui/StatusPill.astro';
import Callout from '../components/ui/Callout.astro';
import Stat from '../components/ui/Stat.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import ExternalLink from '../components/ui/ExternalLink.astro';
import ProjectCover from '../components/project/ProjectCover.astro';
import VideoFacade from '../components/media/VideoFacade.astro';
import Figure from '../components/media/Figure.astro';
import { getCollection } from 'astro:content';
import { STATUS_LABELS } from '../lib/format';

// Borrowed from a real project rather than committing a second copy of an image just for this page.
import sampleImage from '../content/projects/multibank-memory/architecture.png';

const tags = await getCollection('tags');
const statuses = Object.keys(STATUS_LABELS) as (keyof typeof STATUS_LABELS)[];
const stubSlugs = ['school-riscv', 'simple-cache', 'guitar-processor', 'edge-detection'];
---

<ClubLayout title="Styleguide" description="Internal component reference." noindex>
  <Container class="flex flex-col gap-14 py-16">
    <header>
      <h1 class="text-(length:--text-display) leading-(--text-display--line-height)">Styleguide</h1>
      <p class="mt-4 max-w-(--spacing-prose) text-(length:--text-lead) text-(--color-muted)">
        Every primitive, in one place. Toggle the theme in the header and check each one again —
        no colour in this codebase is defined only for dark mode, and this page is where that gets
        caught.
      </p>
    </header>

    <section>
      <h2 class="text-(length:--text-h2)">Type scale</h2>
      <div class="mt-6 flex flex-col gap-3">
        <p class="font-(family-name:--font-display) text-(length:--text-display) leading-(--text-display--line-height)">
          Display — the serif is for headings only
        </p>
        <p class="font-(family-name:--font-display) text-(length:--text-h2)">Heading 2</p>
        <p class="font-(family-name:--font-display) text-(length:--text-h3)">Heading 3</p>
        <p class="text-(length:--text-lead) text-(--color-muted)">
          Lead — used for the one line of context under an h1.
        </p>
        <p>Body — Inter at 1.0625rem / 1.65, capped at 68ch in prose.</p>
        <p class="text-(length:--text-meta) text-(--color-muted)">Meta — 0.875rem, muted.</p>
        <p class="font-(family-name:--font-mono) text-(length:--text-chip)">Mono — tags and code.</p>
      </div>
    </section>

    <section>
      <h2 class="text-(length:--text-h2)">Buttons</h2>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <Button>Primary</Button>
        <Button variant="secondary">Secondary</Button>
        <Button variant="ghost">Ghost</Button>
        <Button href="https://example.com">External</Button>
        <Button disabled>Disabled</Button>
        <Button size="sm" variant="secondary">Small</Button>
      </div>
    </section>

    <section>
      <h2 class="text-(length:--text-h2)">Tags & status</h2>
      <div class="mt-6 flex flex-wrap gap-2">
        {tags.map((tag) => <Chip label={tag.data.label} color={tag.data.color} />)}
        <Chip label="unknown-colour" color="chartreuse" />
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        {statuses.map((status) => <StatusPill status={status} />)}
      </div>
    </section>

    <section>
      <h2 class="text-(length:--text-h2)">Cover stub</h2>
      <p class="mt-2 text-(--color-muted)">
        The tint is derived from the slug, so a project keeps the same colour on every build.
      </p>
      <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          stubSlugs.map((slug) => (
            <li>
              <ProjectCover slug={slug} title={slug} />
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="text-(length:--text-h2)">Surfaces</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <Card>A plain card.</Card>
        <Card href="/club">A linked card — hover raises it 2px.</Card>
        <Card href="https://example.com">An external card.</Card>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <Callout title="Info">Something worth knowing.</Callout>
        <Callout tone="warn" title="Warning">Something worth checking.</Callout>
      </div>
      <dl class="mt-6 grid grid-cols-3 gap-6 rounded-(--radius-lg) border border-(--color-border) p-6">
        <Stat value={20} label="projects published" />
        <Stat value={3} label="years running" />
        <Stat value={11} label="areas covered" />
      </dl>
      <EmptyState class="mt-6" title="Nothing here yet">
        Empty states say what to do next, not just that something is missing.
      </EmptyState>
      <p class="mt-6">
        An <ExternalLink href="https://example.com">external link</ExternalLink> inside a sentence.
      </p>
    </section>

    <section>
      <h2 class="text-(length:--text-h2)">Video facade</h2>
      <p class="mt-2 max-w-(--spacing-prose) text-(--color-muted)">
        This is here because <strong>no seeded project has a video yet</strong>, so without it the
        component that carries the site's most important privacy property (D10 — zero third-party
        requests until a click) would render on no page at all and could rot unnoticed. Delete this
        block once a real project has a demo.
      </p>
      <p class="mt-2 max-w-(--spacing-prose) text-(length:--text-meta) text-(--color-muted)">
        Check three things: with JavaScript off the play button is a plain link to the provider;
        with it on, clicking swaps in the iframe with <em>no</em> layout shift; and the network tab
        shows nothing reaching YouTube until that click. The poster falls back through
        videoPoster → cover → stub, and this one has neither of the first two.
      </p>
      <div class="mt-6 max-w-2xl">
        <VideoFacade
          url="https://youtu.be/8hFwuGJs9DI"
          title="River Raid on FPGA — a 2016 Innopolis student project, used here as a fixture"
          slug="styleguide-demo"
          projectTitle="Video facade fixture"
        />
      </div>
    </section>

    <section>
      <h2 class="text-(length:--text-h2)">Figure</h2>
      <p class="mt-2 max-w-(--spacing-prose) text-(--color-muted)">
        For use inside a project body. AVIF → WebP → source-format ladder, explicit dimensions, and
        a caption that is a real <code>figcaption</code>.
      </p>
      <Figure
        src={sampleImage}
        alt="Block diagram of a multi-bank memory: two read ports and one write port routed through decoders to two banks."
        caption="A figure with a caption, at prose width."
      />
    </section>
  </Container>
</ClubLayout>
