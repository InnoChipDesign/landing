---
/** Header + footer + skip link. Every `/club/*` route. */
import BaseLayout from './BaseLayout.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { routes } from '../lib/routes';
import { site } from '../data/site';
import { breadcrumbs, graph, organization, type Json } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  /** Page-specific structured data. `Organization` is added here and must not be repeated. */
  schema?: (Json | undefined)[];
  /** The trail AFTER the club root, which is prepended. `/club` itself passes nothing. */
  breadcrumb?: { name: string; href: string }[];
}

const { schema = [], breadcrumb, ...props } = Astro.props;

// `Astro.site` is guaranteed by the SITE_URL gate in astro.config.mjs.
const origin = Astro.site!.href;

// Emitted on every club page, so the club resolves to one entity regardless of where a crawler
// enters the site — and so the per-page nodes can reference it by @id instead of restating it.
const jsonLd = graph([
  organization(origin),
  ...schema,
  breadcrumb && breadcrumb.length > 0
    ? breadcrumbs([{ name: site.name, href: routes.club() }, ...breadcrumb], origin)
    : undefined,
]);
---

<BaseLayout {...props} jsonLd={jsonLd} bodyClass="flex min-h-dvh flex-col">
  <SkipLink />
  <Header />
  <main id="main" class="flex-1">
    <slot />
  </main>
  <Footer />
</BaseLayout>
