---
/**
 * The base document. Shared by both zones — the portal at `/` and the club site under `/club`.
 * It carries the head, the tokens and the theme script, and nothing else; chrome belongs to
 * PageLayout (club) or PortalLayout (portal).
 *
 * Deliberately absent, and each for a reason:
 *   · <Analytics /> — the site collects nothing, so there is no cookie banner to write.
 *   · the images.unsplash.com preconnect — no remote images are loaded.
 *   · <ClientRouter /> and prefetch — five static pages; the framework JS was all cost, no benefit.
 * Together these keep the site at zero third-party requests, which is a property worth protecting:
 * it is much easier to keep than to win back.
 */
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import Intersect from '~/components/common/Intersect.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection}>
  <head>
    <CommonMeta />
    <Favicons />
    {/* Display and sans are above the fold on every page; mono never is. */}
    <Font cssVariable="--font-display-face" preload />
    <Font cssVariable="--font-sans-face" preload />
    <Font cssVariable="--font-mono-face" />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    {
      /* Load-bearing: every WidgetWrapper starts at `motion-safe:md:opacity-0` and is revealed by
        this observer. Removing it renders the site blank above `md` and fine on mobile. */
    }
    <Intersect />
  </body>
</html>
