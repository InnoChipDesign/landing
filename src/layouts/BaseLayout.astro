---
/**
 * The <head>, the tokens and the theme script. Used by BOTH zones — the portal at `/` and every
 * `/club/*` page — so a visitor who arrives at `/club` from a link and then finds `/` via the
 * footer never feels they have crossed into a different organisation (06 §8).
 *
 * It renders no navigation of its own. Chrome is PortalLayout's or ClubLayout's job.
 */
import { Font } from 'astro:assets';

import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import { ensureContentValid } from '../lib/validate';

interface Props {
  title: string;
  description: string;
  /** Overrides the derived canonical. Only needed for a page that is served at two paths. */
  canonical?: string;
  /** Absolute or root-relative OG image. Falls back to the site default card. */
  image?: string;
  imageAlt?: string;
  /** `website` for landing pages, `article` for a project. */
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  /** Structured data for this page, built by `src/lib/seo.ts`. */
  jsonLd?: string;
  bodyClass?: string;
}

// Cross-file content assertions run once per build, from the one module every route passes
// through (02 §2, src/lib/validate.ts). A malformed project fails the build here rather than
// shipping a broken page.
await ensureContentValid();

const { bodyClass = '', ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Seo {...seo} type={seo.ogType} />

    {/* Emits the @font-face rules and the `--font-*-face` variables global.css consumes.
        `preload` on the two families used above the fold on every page; the mono face is only
        reached by code blocks and tag chips, so preloading it would compete with the LCP image
        for bandwidth it does not need. */}
    <Font cssVariable="--font-display-face" preload />
    <Font cssVariable="--font-sans-face" preload />
    <Font cssVariable="--font-mono-face" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Matches --color-bg in each theme, not the brand green. The browser paints this behind its
        own chrome, directly adjacent to the page — a green bar above a white page reads as a
        rendering seam. Two tags, because this one meta cannot reference a CSS variable. */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)" />

    {/* No analytics, no tracking scripts, no cookies, no consent banner (D13). */}

    {/* Applies the stored theme before first paint, so there is no flash of the wrong one. This
        script is deliberately blocking and deliberately tiny; it must run before <body> paints.
        The `js` class is what un-hides controls that only work with JavaScript. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const stored = localStorage.getItem('theme');
          const dark =
            stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          root.classList.toggle('dark', dark);
        } catch {
          /* localStorage can throw in a locked-down browser; light is a fine default. */
        }
      })();
    </script>
  </head>

  <body class={bodyClass}>
    <slot />
  </body>
</html>
