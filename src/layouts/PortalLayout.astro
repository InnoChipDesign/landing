---
/**
 * The portal at `/` (D19). No header nav, no footer nav — it is a switchboard, not a page.
 *
 * It shares BaseLayout, every token, both fonts and the theme script with the club zone. What
 * distinguishes it is DENSITY, not palette (06 §8): three large cards, a short page, no
 * navigation. If it ever grows a projects section or an about paragraph it has become a homepage,
 * and the /club split has lost its point.
 */
import BaseLayout from './BaseLayout.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import { graph, organization, website } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const props = Astro.props;

// `WebSite` belongs on `/` and nowhere else (07 §1) — the portal is this site's homepage as far as
// a crawler is concerned, even though the content lives under /club. `Organization` goes on both
// zones, so the two never look like two different clubs.
const origin = Astro.site!.href;
const jsonLd = graph([organization(origin), website(origin)]);
---

<BaseLayout {...props} jsonLd={jsonLd} bodyClass="flex min-h-dvh flex-col">
  <SkipLink />
  <main id="main" class="flex flex-1 flex-col justify-center">
    <slot />
  </main>
</BaseLayout>
